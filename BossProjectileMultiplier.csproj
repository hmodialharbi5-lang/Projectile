<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>BossProjectileMultiplier</AssemblyName>
    <RootNamespace>BossProjectileMultiplier</RootNamespace>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TerrariaServer">
      <HintPath>lib/TerrariaServer.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="TShockAPI">
      <HintPath>lib/TShockAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="TerrariaApi.Server">
      <HintPath>lib/TerrariaApi.Server.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
